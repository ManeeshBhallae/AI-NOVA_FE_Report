# Copy this to .env in YOUR consuming app's root (never commit the real file)
# and fill in values from your own BTP AI Core service key / destination.
# This package never ships or reads credentials of its own.

# Local dev: the AI Core service key binding, exactly as `cf create-service-key`
# / the BTP cockpit gives it to you (single-line JSON). Not read in Cloud
# Foundry at all - .env files aren't deployed - so this is a dev-only path.
AICORE_SERVICE_KEY='{"serviceurls":{"AI_API_URL":"..."},"clientid":"...","clientsecret":"...","url":"...","identityzone":"..."}'

# Production alternative to the above - a BTP destination name instead of a
# raw key. Only resolves if this app is bound to a destination service
# instance, which requires CF deploy config (mta.yaml) to exist first. Set
# this in your CF app's environment (not this file) once deployed; leave it
# unset for local dev. When set, AICORE_SERVICE_KEY above is ignored.
# NOVA_AI_DESTINATION=your-ai-core-destination-name

# Optional. Defaults to anthropic--claude-4.5-haiku if unset.
# NOVA_MODEL=anthropic--claude-4.5-haiku

# Optional. A separate (usually cheaper) model for document reading only -
# field extraction and invoice line items are transcription, not reasoning,
# and are the token-heaviest calls. Falls back to NOVA_MODEL when unset.
# NOVA_DOC_MODEL=anthropic--claude-4.5-haiku

# Optional. Defaults to "default" if unset.
# NOVA_RESOURCE_GROUP=default

# Optional cost tracking. Your contract's tokens-to-capacity-unit conversion
# rates per 1000 tokens (from SAP's pricing calculator for your model -
# either separate input/output rates, or the same blended rate in both),
# plus the money price per CU in whatever currency your contract uses
# (NOVA_CURRENCY is a display label only - no FX logic). Unset = the app
# shows raw token counts only, never an invented cost figure.
# NOVA_CU_PER_1K_PROMPT=0.0042456
# NOVA_CU_PER_1K_COMPLETION=0.0042456
# NOVA_PRICE_PER_CU=108.16
# NOVA_CURRENCY=INR

# Optional. Where the persistent all-time usage totals are stored.
# Defaults to .nova-usage.json in the app root.
# NOVA_USAGE_FILE=.nova-usage.json
